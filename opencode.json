{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
    "servers": {
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "system_prompt.py": "ask",
      "lumen_security.py": "ask",
      "lumen_router_config.py": "ask",
      "Dockerfile": "ask",
      ".github/workflows/*": "ask"
    },
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git reset --hard*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf *": "deny"
    }
  }
}
